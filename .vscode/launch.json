	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Google Test",
			"type": "cppdbg",
			"request": "launch",
			"program": "${workspaceFolder}/build/bin/test/test_A.exe", // 修改为你的测试可执行文件路径
			"args": [],
			"stopAtEntry": true,
			"cwd": "${workspaceFolder}",
			"environment": [],
			"externalConsole": false,
			"MIMode": "gdb",
			"setupCommands": [
			  {
				"description": "Enable pretty-printing for gdb",
				"text": "-enable-pretty-printing",
				"ignoreFailures": true
			   }
			],
			"miDebuggerPath": "C:/cygwin64/bin/gdb.exe",
		  }
	]
}